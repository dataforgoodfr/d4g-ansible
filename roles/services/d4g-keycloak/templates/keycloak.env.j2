# Compte d'administration initial du realm master. Keycloak ne le cree qu'au
# tout premier demarrage, sur une base vide.
KC_BOOTSTRAP_ADMIN_USERNAME={{ keycloak_admin_user }}
KC_BOOTSTRAP_ADMIN_PASSWORD={{ lookup('env', 'KEYCLOAK_ADMIN_PASSWORD') }}

KC_DB=postgres
KC_DB_URL_HOST={{ lookup('env', 'POLETECH_DB_HOST') }}
KC_DB_URL_PORT={{ lookup('env', 'POLETECH_DB_PORT') }}
KC_DB_URL_DATABASE=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD={{ lookup('env', 'KEYCLOAK_DB_PASSWORD') }}

# Traefik termine TLS et parle en clair au conteneur, comme pour les autres
# services du swarm. Sans `KC_PROXY_HEADERS`, Keycloak construit ses URLs de
# redirection en http:// et la connexion boucle.
KC_HOSTNAME=https://keycloak.{{ base_domain }}
KC_HTTP_ENABLED=true
KC_PROXY_HEADERS=xforwarded

KC_HEALTH_ENABLED=true
