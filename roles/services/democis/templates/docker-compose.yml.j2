services:
  web:
    # Le site est construit par https://github.com/dataforgoodfr/democis-site
    image: ghcr.io/dataforgoodfr/democis-site:main-16838a6
    env_file:
      - democis.env
    volumes:
      # Les actualités créées depuis le back-office vivent dans ./actus (persistant).
      - ./actus:/var/www/html/actus
    deploy:
      replicas: {{ replicas }}
      placement:
        constraints:
          - node.hostname == {{ deploy_on }}
      restart_policy:
        condition: on-failure
    networks:
      - d4g-internal


networks:
  d4g-internal:
    external: true
